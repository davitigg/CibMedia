<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CibMedia.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Presentation/Setup/Setup.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CibMedia.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TMDbLib" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CibMedia.Playback/CibMedia.Playback.csproj" />
  </ItemGroup>

  <!-- TMDbLib is nullable-oblivious: every container it returns is typed as maybe-null. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8604</NoWarn>
  </PropertyGroup>

</Project>
